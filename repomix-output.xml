@dataclass
class RunResult:
    run_mode: str
    track_results: List[List[np.ndarray]]
    processed_frames: int
    total_detect_time: float
    trace: Optional[ReferenceTrace] = None
    track_metric_rows: List[dict] = field(default_factory=list)
